// examples/atom_reduction_smem/kernel.ptx
// 128 threads each atom.shared.add 1 to smem offset 0.
// Thread 0 initialises counter to 0, all threads barrier, all atomicAdd 1,
// barrier again, thread 0 writes result to OUT.
.visible .entry test(.param .u64 OUT)
{
    .reg .u64 %rd<3>;
    .reg .u32 %r<4>;
    .reg .pred %p0;

    // %rd0 = smem offset 0 (the counter lives at byte offset 0)
    mov.u64 %rd0, 0;

    mov.u32 %r0, %tid.x;
    setp.ne.u32 %p0, %r0, 0;
    @%p0 bra ATOMIC;

    // Thread 0: initialise smem[0] = 0
    mov.u32 %r1, 0;
    st.shared.u32 [%rd0], %r1;

ATOMIC:
    bar.sync 0;

    // All 128 threads: atomic add 1 to smem[0]
    mov.u32 %r2, 1;
    atom.shared.add.u32 %r3, [%rd0], %r2;

    bar.sync 0;

    // Thread 0: read final count and write to OUT
    setp.ne.u32 %p0, %r0, 0;
    @%p0 bra DONE;
    ld.shared.u32 %r1, [%rd0];
    ld.param.u64 %rd1, [OUT];
    st.global.u32 [%rd1], %r1;

DONE:
    ret;
}
