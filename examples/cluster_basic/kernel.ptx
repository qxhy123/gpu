.entry test(.param .u64 OUT)
{
    .reg .u64 %rd<3>;
    .reg .u32 %r<3>;
    .reg .pred %p0;

    ld.param.u64 %rd0, [OUT];
    mov.u32 %r0, %ctaid.x;
    mul.lo.s32 %r1, %r0, 4;
    cvt.u64.u32 %rd1, %r1;
    add.u64 %rd2, %rd0, %rd1;

    mov.u32 %r2, %tid.x;
    setp.eq.u32 %p0, %r2, 0;
    @!%p0 bra END;
    st.global.u32 [%rd2], %r0;
END:
    barrier.cluster.arrive;
    barrier.cluster.wait;
    ret;
}
