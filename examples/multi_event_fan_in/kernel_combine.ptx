.visible .entry test(.param .u64 A, .param .u64 B, .param .u64 OUT)
{
    .reg .u64 %rd<6>;
    .reg .u32 %r<6>;

    ld.param.u64 %rd0, [A];
    ld.param.u64 %rd1, [B];
    ld.param.u64 %rd2, [OUT];

    mov.u32 %r0, %tid.x;
    shl.b32 %r1, %r0, 2;
    cvt.u64.u32 %rd3, %r1;

    add.u64 %rd4, %rd0, %rd3;
    ld.global.u32 %r2, [%rd4];
    add.u64 %rd4, %rd1, %rd3;
    ld.global.u32 %r3, [%rd4];

    add.s32 %r4, %r2, %r3;

    add.u64 %rd4, %rd2, %rd3;
    st.global.u32 [%rd4], %r4;

    ret;
}
