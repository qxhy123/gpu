// examples/multi_stream_pipeline_full/kernel_compute.ptx
// Multiply IN[tid.x] by 2 -> OUT[tid.x] (compute stage).
// Uses add.f32 %f1, %f0, %f0 (x + x = 2x) since hex float literals
// (0f40000000) are not supported by this PTX parser.
.visible .entry compute(.param .u64 IN, .param .u64 OUT)
{
    .reg .u64 %rd<6>;
    .reg .u32 %r<4>;
    .reg .f32 %f<3>;

    ld.param.u64 %rd0, [IN];
    ld.param.u64 %rd1, [OUT];

    mov.u32 %r0, %tid.x;
    shl.b32 %r1, %r0, 2;
    cvt.u64.u32 %rd2, %r1;

    add.u64 %rd3, %rd0, %rd2;
    ld.global.f32 %f0, [%rd3];
    add.f32 %f1, %f0, %f0;
    add.u64 %rd3, %rd1, %rd2;
    st.global.f32 [%rd3], %f1;

    ret;
}
