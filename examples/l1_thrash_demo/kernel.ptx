// Each thread reads K cache lines (working set) and iterates the K-line set
// OUTER_LOOPS times. Total accesses per thread = OUTER_LOOPS * K. The outer
// loop is what creates reuse — without it every iteration touches new lines
// and L1 hit rate is 0%.
.visible .entry l1_thrash(.param .u64 A, .param .u64 OUT,
                          .param .u32 K, .param .u32 STRIDE,
                          .param .u32 OUTER_LOOPS)
{
    .reg .u32 %r<10>; .reg .u64 %rd<5>; .reg .f32 %f<2>; .reg .pred %p<2>;
    ld.param.u64 %rd1, [A];
    ld.param.u64 %rd2, [OUT];
    ld.param.u32 %r1, [K];
    ld.param.u32 %r2, [STRIDE];
    ld.param.u32 %r9, [OUTER_LOOPS];

    mov.u32 %r3, %tid.x;
    mov.u32 %r8, 0;
OUTER:
    setp.ge.s32 %p1, %r8, %r9;
    @%p1 bra DONE_OUTER;
    mov.u32 %r4, 0;
INNER:
    setp.ge.s32 %p1, %r4, %r1;
    @%p1 bra DONE_INNER;
    mul.lo.s32 %r5, %r4, %r2;
    add.s32 %r6, %r3, %r5;
    shl.b32 %r7, %r6, 2;
    cvt.u64.u32 %rd3, %r7;
    add.u64 %rd4, %rd1, %rd3;
    ld.global.f32 %f1, [%rd4];
    add.s32 %r4, %r4, 1;
    bra INNER;
DONE_INNER:
    add.s32 %r8, %r8, 1;
    bra OUTER;
DONE_OUTER:
    shl.b32 %r7, %r3, 2;
    cvt.u64.u32 %rd3, %r7;
    add.u64 %rd2, %rd2, %rd3;
    st.global.f32 [%rd2], %f1;
}
